{"$id": "ipvv:passage:v1", "$schema": "https://json-schema.org/draft/2020-12/schema", "description": "SOURCE unit: one cut passage. Chunk boundaries are immutable once cut (karika/verse/para as unit, container as parent).", "required": ["id", "chunk_id", "line_end", "line_start", "order", "sanskrit", "source_edition", "work_id"], "properties": {"char_len": {"type": "integer"}, "chunk_id": {"description": "human chunk key, e.g. chunkV2-A (stable across reruns)", "type": "string"}, "id": {"description": "resolvable id, e.g. pt:passage:ipvv:chunkV2-A", "pattern": "^pt:passage:[a-z0-9-]+:.+$", "type": "string"}, "immutable_id": {"description": "content hash id, e.g. pt:pid:ipvv:165115d8eb7d", "type": "string"}, "line_end": {"type": "integer"}, "line_start": {"type": "integer"}, "locator": {"description": "edition locator, e.g. M00021 lines 29-700", "type": "string"}, "order": {"type": "integer", "minimum": 0}, "sanskrit": {"description": "verbatim source text, unedited", "minLength": 1, "type": "string"}, "source_edition": {"type": "string"}, "status": {"enum": ["SOURCE", "NEEDS_MAPPING", "OK"], "type": "string"}, "vol": {"type": "string"}, "work_id": {"type": "string"}}, "title": "ipvv SOURCE passage", "type": "object"}
